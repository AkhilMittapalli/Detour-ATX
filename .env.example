# Copy this file to .env and fill in what you need.
# .env is gitignored. Never commit it, never paste a key into chat.

# --- agents (Verifier, Desk Editor, description rewrite) -----------------
GEMINI_API_KEY=paste-your-key-here
# GEMINI_MODEL=gemini-3.8-flash

# --- open data ------------------------------------------------------------
# Free, and worth having before any scheduled run: without one you share a
# throttled pool with everyone hitting the portal anonymously.
# SOCRATA_APP_TOKEN=

# --- delivery by email ----------------------------------------------------
# Use an app password, never your account password. Port 465 uses implicit
# TLS; anything else uses STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com
# SMTP_TO=you@gmail.com

# --- delivery by webhook (Slack, Discord, ntfy, anything) -----------------
# Must be HTTPS.
# DETOUR_WEBHOOK_URL=
